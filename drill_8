Drill 8 — Strategic Customer Risk Radar
Exact task statement
Build a risk radar for high-value customers using size, decline, credits, volatility, and decline streak.
Build order
29.	Start from customer_month_base.
30.	Calculate trailing 12-month revenue, recent growth, credit ratio, and volatility score.
31.	Derive decline_streak_months from month-on-month revenue movement.
32.	Assign risk_points and risk_flag using fixed rules.
Validation checks
•	Risk points must tie exactly to your documented scoring logic.
•	Volatility must be based on monthly revenue, not transaction-level data.
•	Decline streak must reset when month-on-month growth turns positive.
Final output template
customer_code	oracle_customer_name	trailing_12m_revenue	recent_growth_pct	credit_ratio_pct	volatility_score	decline_streak_months	risk_points	risk_flag
100234	Customer A	48200000	-11.4%	-6.2%	0.41	3	4	High
Output column definitions
•	volatility_score = stddev(monthly_revenue) / avg(monthly_revenue).
•	decline_streak_months = consecutive recent months with lower revenue than the immediately prior month.
•	risk_flag = final risk band derived from risk_points.
--==========================================================================================================================

--The output of cte_1 is a list of all customers with revenue aggregated at customer level
--and belonging to the tailing 12 month group
With cte_1 as 
(Select
	t.customer_code,
	t.oracle_customer_name,
	t.top150_mapping,
	date_trunc('month', t.rev_mth_dt)::date as rev_mth_dt,	
	--Combining multiple rows of invoices for each customer into a single line per month
	Sum(t.amount) as customer_revenue,
	--marking the months that fall under the trailing 12 month window
	--this will be used to filter only the lines that belong to the trailing 12 month window
	p.is_trailing_12m as ttm_flag
From platinum.txn_normalized t
Left Join platinum.period_reference p --Joining with the table where the TTM flag is set up
On t.rev_mth_dt = p.month_start
Where p.is_trailing_12m = 1 --this filters out all the lines that do not belong in the TTM group
Group By
	t.customer_code,
	t.oracle_customer_name,
	t.top150_mapping,
	date_trunc('month', t.rev_mth_dt)::date,
	--t.amount,
	p.is_trailing_12m
Order by 1, 5 desc
),
--the output of cte_2 is all the rows of cte_1 with additonal colums like TTM revenue, max month, flag
cte_2 as
(
Select
	customer_code,
	oracle_customer_name,
	top150_mapping,
	--the line below aggregates a customer's revenue into a single value which is the total TTM revenue
	--in the output this is seen a a value repeating in all the lines as we have not yet applied
	--the filter to bring everything into a single row
	Sum(customer_revenue) over(partition by customer_code) as rev_12mth,
	rev_mth_dt,
	--max of rev_mth_dt will return the latest month for which we have revenue data for a customer
	--this will also repeat across rows due to no filtering at this stage
	--sole purpose is to finally filter out all rows except the max row
	Max(rev_mth_dt) over(partition by customer_code) as max_dt,
	customer_revenue,
	--creating a new column to get the prior month's revenue for comparison and determination of rev growth
	Lead(customer_revenue) over(partition by customer_code order by rev_mth_dt desc) as prev_mth_rev,
	--assigning flag to identify customer which have current revenue lower than immediately preceding month
	Case
		When customer_revenue < Lead(customer_revenue) over(partition by customer_code order by rev_mth_dt desc)
		Then 1
		Else 0
	End change_flag,
	--the next three statements are solely for calculating the volatitly score:= std_dev(revenue) / avg(revenue)
	stddev_samp(customer_revenue) over(partition by customer_code) as std_dev_rev,
	avg(customer_revenue) over(partition by customer_code) as avg_rev,
	Round(stddev_pop(customer_revenue) over(partition by customer_code) / 
		nullif(avg(customer_revenue) over(partition by customer_code),0),2) as vol_score
From cte_1
Group by
	customer_code,
	oracle_customer_name,
	top150_mapping,
	customer_revenue,
	rev_mth_dt
),
cte_3 as(
Select 
	*,
	--Very important logic thanks to ChatGPT. A part of the drill is to find the declining streak of every customer
	--for this, we created a flag based on revenue comparison between customer_revenue and prev_mth_rev
	--this part uses that flag to create what is called stop_group. The logic is that SQL has to know when to stop
	--counting. With this we have created two flags. As long as the filter condition is satisfied for both flags, the count
	--continues. Once it fails, count stops and the result is the number of consecutive decline months.
	Sum(case when change_flag = 1 Then 0 Else 1 End)
	Over(partition by customer_code order by rev_mth_dt desc
			rows between unbounded preceding and current row) stop_group
From cte_2
),
cte_4 as
(Select 
	*,
	Count(*) over(partition by customer_code) as declining_streak
From cte_3
Where 
	change_flag = 1 AND stop_group = 0
Group by
	customer_code,
	oracle_customer_name,
	top150_mapping,
	customer_revenue,
	rev_mth_dt,
	rev_12mth,
	max_dt,
	prev_mth_rev,
	change_flag,
	std_dev_rev,
	avg_rev,
	vol_score,
	stop_group
)
Select 
	customer_code,
	oracle_customer_name,
	top150_mapping,
	rev_12mth,
	customer_revenue,
	prev_mth_rev,
	Round((((customer_revenue / nullif(prev_mth_rev,0)) - 1)::numeric)*100,2) as recent_pct_growth,
	vol_score,
	declining_streak
From cte_4
Where 
	rev_mth_dt = max_dt






